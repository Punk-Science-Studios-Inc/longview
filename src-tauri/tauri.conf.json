{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Longview", "version": "0.2.0", "identifier": "ca.punkscience.longview",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Longview", "width": 1100, "height": 800, "minWidth": 620, "minHeight": 480, "backgroundColor": "#F7F0DF" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'" }
  },
  "bundle": {
    "active": true, "targets": "all", "shortDescription": "A quiet workspace for Markdown",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
